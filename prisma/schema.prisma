generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator pothos {
  provider     = "prisma-pothos-types"
  output       = "../src/generated/pothos-types.ts"
  clientOutput = "./prisma"
}

datasource db {
  provider = "postgresql"
}

model Sentence {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quote     String?
  author    String?
}
